<!--
  細隙灯アライメント シーン（M0：配置、M1：連動拘束・アーム）
  座標系：x = 右(+)/左(-)（検者から見て）、y = 奥（患者側）、z = 上。単位は m。
  患者は y=+0.32 に座り、-y 方向（検者側）を向いている。
-->
<!-- 自動生成：scripts/make_sl130.py（直接編集しない）。scene.xml に SL130 の見た目を足したもの -->
<mujoco model="slitlamp_scene_sl130">
  <compiler angle="degree"/>
  <!-- scene.xml と同じ値に固定（影の範囲を同じにする） -->
  <statistic center="0 -0.123217601 0.85" extent="2.1" meansize="0.162003481" meanmass="14.6347603" meaninertia="0.518024723"/>
  <option timestep="0.002" gravity="0 0 -9.81">
    <!-- 衝突判定は使わない（握る動作は weld 拘束で表すため）。計算が速く安定する -->
    <flag contact="disable"/>
  </option>

  <default>
    <!-- 拘束の硬さ：solref の1つ目（時定数）が小さいほど硬い。timestep の2倍(0.004)が下限の目安 -->
    <equality solref="0.004 1"/>
    <!-- アーム用の既定値：関節の粘り・見かけの慣性、位置制御モーターの強さ(kp)と減衰(kv) -->
    <default class="arm">
      <joint damping="1" armature="0.01"/>
      <geom material="arm_mat"/>
      <!-- 反応の速さの目安は kv/kp [s]。M1 は 150/15（0.1秒）で遅れが目立ったため、M2 で 250/6 に変更 -->
      <position kp="250" kv="6"/>
      <!-- SL130 の見た目だけの部品：重さ0・衝突なし。つまみの関節は軽く、少し粘りを持たせる。
         描画グループ2：細隙灯カメラの画像を撮るときだけ隠す（室内灯の影が顔に落ちて画像が変わらないように、sim/env.py） -->
    <default class="sl">
      <geom contype="0" conaffinity="0" density="0" material="sl_white" group="2"/>
      <joint type="hinge" damping="0.001" armature="0.0001"/>
    </default>
  </default>
  </default>

  <visual>
    <!-- 画面なし描画（オフスクリーン）の最大解像度 -->
    <global offwidth="1280" offheight="960"/>
    <headlight ambient="0.35 0.35 0.35" diffuse="0.4 0.4 0.4"/>
  </visual>

  <asset>
    <texture name="sky" type="skybox" builtin="gradient" rgb1="0.85 0.9 0.95" rgb2="0.4 0.5 0.6" width="256" height="256"/>
    <texture name="floor_tex" type="2d" builtin="checker" rgb1="0.75 0.75 0.75" rgb2="0.6 0.6 0.6" width="256" height="256"/>
    <material name="floor_mat" texture="floor_tex" texrepeat="8 8"/>
    <material name="table_mat"  rgba="0.55 0.42 0.3 1"/>
    <material name="lamp_mat"   rgba="0.92 0.92 0.9 1"/>
    <material name="metal_mat"  rgba="0.45 0.45 0.5 1"/>
    <material name="black_mat"  rgba="0.08 0.08 0.08 1"/>
    <material name="skin_mat"   rgba="0.93 0.76 0.65 1"/>
    <material name="sclera_mat" rgba="0.97 0.96 0.94 1"/>
    <material name="iris_mat"   rgba="0.40 0.25 0.12 1"/>
    <material name="pupil_mat"  rgba="0.02 0.02 0.02 1"/>
    <material name="arm_mat"    rgba="0.95 0.55 0.15 1"/>
    <material name="arm_dark"   rgba="0.25 0.25 0.28 1"/>
    <!-- 瞼の形（M4-E）：scripts/make_lids.py で作る。上瞼は閉じ具合ごとに13個、下瞼は1個 -->
    <mesh name="lid_up_00" file="lids/lid_up_00.obj"/>
    <mesh name="lid_up_01" file="lids/lid_up_01.obj"/>
    <mesh name="lid_up_02" file="lids/lid_up_02.obj"/>
    <mesh name="lid_up_03" file="lids/lid_up_03.obj"/>
    <mesh name="lid_up_04" file="lids/lid_up_04.obj"/>
    <mesh name="lid_up_05" file="lids/lid_up_05.obj"/>
    <mesh name="lid_up_06" file="lids/lid_up_06.obj"/>
    <mesh name="lid_up_07" file="lids/lid_up_07.obj"/>
    <mesh name="lid_up_08" file="lids/lid_up_08.obj"/>
    <mesh name="lid_up_09" file="lids/lid_up_09.obj"/>
    <mesh name="lid_up_10" file="lids/lid_up_10.obj"/>
    <mesh name="lid_up_11" file="lids/lid_up_11.obj"/>
    <mesh name="lid_up_12" file="lids/lid_up_12.obj"/>
    <mesh name="lid_low" file="lids/lid_low.obj"/>
    <!-- ===== Zeiss SL130 の見た目（M6-①、scripts/make_sl130.py が作る） ===== -->
    <material name="sl_white" rgba="0.86 0.87 0.86 1"/>
    <material name="sl_black" rgba="0.07 0.07 0.07 1"/>
    <material name="sl_knurl" rgba="0.16 0.16 0.16 1"/>
    <material name="sl_glass" rgba="0.18 0.22 0.27 1" specular="0.8" shininess="0.9"/>
    <material name="sl_steel" rgba="0.72 0.73 0.75 1" specular="0.6" shininess="0.6"/>
    <material name="sl_red"   rgba="0.85 0.12 0.10 1"/>
    <texture name="dial_R_tex" type="2d" file="sl130/dial_R.png"/>
    <texture name="dial_L_tex" type="2d" file="sl130/dial_L.png"/>
    <material name="dial_R_mat" texture="dial_R_tex"/>
    <material name="dial_L_mat" texture="dial_L_tex"/>
    <mesh name="dial_R" file="sl130/dial_R.obj"/>
    <mesh name="dial_L" file="sl130/dial_L.obj"/>
  </asset>

  <worldbody>
    <light name="room_light" pos="0 -0.5 2.5" dir="0 0.3 -1" diffuse="0.6 0.6 0.6"/>
    <geom name="floor" type="plane" size="2 2 0.1" material="floor_mat"/>

    <!-- 診察台：天板の上面が z=0.75 -->
    <body name="table" pos="0 0.05 0">
      <geom name="table_top" type="box" pos="0 0 0.73" size="0.40 0.35 0.02" material="table_mat"/>
      <geom name="table_leg" type="box" pos="0 0 0.355" size="0.30 0.25 0.355" material="table_mat"/>
    </body>

    <!-- SL130 の土台（台に固定、見た目のみ）：T字形の板、奥の左右のレール -->
    <body name="sl_baseplate" pos="0 0 0.75" childclass="sl">
      <geom name="sl_plate_main"  type="box" pos="0 0.07 0.003"  size="0.20 0.24 0.003"/>
      <geom name="sl_plate_front" type="box" pos="0 -0.215 0.003" size="0.075 0.045 0.003"/>
      <geom name="sl_rail"        type="cylinder" fromto="-0.19 -0.14 0.012 0.19 -0.14 0.012" size="0.005" material="sl_steel"/>
      <geom name="sl_rail_end_L"  type="box" pos="-0.19 -0.14 0.012" size="0.012 0.02 0.012"/>
      <geom name="sl_rail_end_R"  type="box" pos=" 0.19 -0.14 0.012" size="0.012 0.02 0.012"/>
    </body>

    <!-- ===== 細隙灯 ===== -->
    <!-- 基台：左右(x)・前後(y)にスライドする -->
    <body name="lamp_base" pos="0 -0.10 0.75">
      <joint name="lamp_x" type="slide" axis="1 0 0" range="-0.07 0.07" damping="50"/>
      <joint name="lamp_y" type="slide" axis="0 1 0" range="-0.04 0.04" damping="50"/>
      <geom name="base_plate" group="3" type="box" pos="0 -0.02 0.02" size="0.12 0.10 0.02" material="lamp_mat"/>
      <!-- SL130 の基台（見た目のみ）：本体の台、操作棒の丸い台座、明るさのつまみ -->
      <geom name="sl_carriage"  class="sl" type="box" pos="0 0.0 0.022" size="0.05 0.07 0.022"/>
      <geom name="sl_front"     class="sl" type="box" pos="0 -0.06 0.018" size="0.045 0.03 0.018"/>
      <geom name="sl_js_socket" class="sl" type="cylinder" pos="0 -0.09 0.018" size="0.036 0.018"/>
      <geom name="sl_js_hole"   class="sl" type="cylinder" pos="0 -0.09 0.037" size="0.016 0.001" material="sl_black"/>
      <body name="sl_brightness" pos="0.042 -0.075 0.036" childclass="sl">
        <inertial pos="0 0 0" mass="0.001" diaginertia="1e-7 1e-7 1e-7"/>
        <joint name="brightness" axis="0 0 1"/>
        <geom name="sl_brightness_knob" type="cylinder" pos="0 0 0.009" size="0.008 0.009" material="sl_black"/>
      </body>

      <!-- ジョイスティック：基台の手前（検者側）に立つ。3つの回転関節 -->
      <body name="joystick" pos="0 -0.09 0.04">
        <!-- armature：関節に見かけの慣性を足す。軽いスティックと重い本体を拘束でつなぐときの計算を安定させる -->
        <joint name="js_pitch" type="hinge" axis="1 0 0" range="-20 20" damping="0.5" armature="0.05"/>  <!-- 前後に倒す -->
        <joint name="js_roll"  type="hinge" axis="0 1 0" range="-25 25" damping="0.5" armature="0.05"/>  <!-- 左右に倒す -->
        <joint name="js_spin"  type="hinge" axis="0 0 1" range="-360 360" damping="0.5" armature="0.05"/> <!-- 軸回転＝高さ -->
        <geom name="js_shaft" group="3" type="capsule" fromto="0 0 0 0 0 0.10" size="0.006" material="metal_mat"/>
        <geom name="js_knob" group="3"  type="sphere" pos="0 0 0.11" size="0.016" material="black_mat"/>
        <!-- SL130 の操作棒（見た目のみ）：太い黒い棒と、ローレットの付いた頭 -->
        <geom name="sl_js_handle" class="sl" type="cylinder" fromto="0 0 0.0 0 0 0.10" size="0.012" material="sl_black"/>
        <geom name="sl_js_head"   class="sl" type="cylinder" fromto="0 0 0.09 0 0 0.125" size="0.0155" material="sl_knurl"/>
        <site name="js_grip" pos="0 0 0.11" size="0.005"/>
      </body>

      <!-- 支柱：上下(z)にスライドする＝高さ調整 -->
      <!-- gravcomp="1"：この部品の重さを打ち消す（実機の高さ調整ネジが自重を支えるのに相当） -->
      <body name="lamp_column" pos="0 0 0.04" gravcomp="1">
        <joint name="lamp_z" type="slide" axis="0 0 1" range="-0.03 0.03" damping="50"/>
        <geom name="column" group="3" type="cylinder" fromto="0 0 0 0 0 0.26" size="0.018" material="lamp_mat"/>
        <!-- SL130 の共通の回転軸と、顕微鏡の「コ」の字の腕（見た目のみ） -->
        <geom name="sl_pivot"     class="sl" type="cylinder" pos="0 0.03 0.025" size="0.032 0.025"/>
        <geom name="sl_pivot_scale" class="sl" type="cylinder" pos="0 0.03 0.038" size="0.0325 0.004" material="sl_steel"/>
        <geom name="sl_arm_low"   class="sl" type="box" pos="0 -0.005 0.03"  size="0.017 0.04 0.014"/>
        <geom name="sl_arm_up"    class="sl" type="box" pos="0 -0.033 0.125" size="0.017 0.015 0.095"/>
        <geom name="sl_arm_top"   class="sl" type="box" pos="0 -0.012 0.212" size="0.017 0.032 0.013"/>
        <!-- 照明の本体：顕微鏡の腕の前（患者側）。両側に黒いつまみ、前の下に黒い格子 -->
        <geom name="sl_illum_box" class="sl" type="box" pos="0 0.085 0.105" size="0.028 0.032 0.05"/>
        <geom name="sl_illum_grille" class="sl" type="box" pos="0 0.1175 0.078" size="0.02 0.0015 0.02" material="sl_black"/>
        <geom name="sl_illum_tube" class="sl" type="cylinder" fromto="0 0.09 0.155 0 0.09 0.236" size="0.0125" material="sl_black"/>
        <!-- 照明の筒のローレット：回すと光の当たる位置が上下に動く -->
        <body name="sl_illum_vert" pos="0 0.09 0.2" childclass="sl">
          <inertial pos="0 0 0" mass="0.001" diaginertia="1e-7 1e-7 1e-7"/>
          <joint name="illum_vert" axis="0 0 1"/>
          <geom name="sl_illum_knurl" type="cylinder" size="0.0145 0.016" material="sl_knurl"/>
          <geom name="sl_illum_knurl_mark" type="box" pos="0 -0.0145 0" size="0.0015 0.001 0.016" material="sl_white"/>
        </body>
        <geom name="sl_illum_head" class="sl" type="box" pos="0 0.09 0.243" size="0.011 0.011 0.007" material="sl_black"/>
        <!-- 照明のつまみ（左右両側、一緒に回る）：上から 光の左右（偏心）、（未使用）、スリットの幅、（未使用） -->
        <body name="sl_illum_decenter" pos="0 0.075 0.142" childclass="sl">
          <inertial pos="0 0 0" mass="0.001" diaginertia="1e-7 1e-7 1e-7"/>
          <joint name="illum_decenter" axis="1 0 0"/>
          <geom name="sl_knob_dec_R" type="cylinder" fromto=" 0.028 0 0  0.04 0 0" size="0.007" material="sl_black"/>
          <geom name="sl_knob_dec_L" type="cylinder" fromto="-0.028 0 0 -0.04 0 0" size="0.007" material="sl_black"/>
        </body>
        <geom name="sl_knob_2_R" class="sl" type="cylinder" fromto=" 0.028 0.075 0.12  0.039 0.075 0.12" size="0.008" material="sl_black"/>
        <geom name="sl_knob_2_L" class="sl" type="cylinder" fromto="-0.028 0.075 0.12 -0.039 0.075 0.12" size="0.008" material="sl_black"/>
        <body name="sl_slit_width" pos="0 0.075 0.093" childclass="sl">
          <inertial pos="0 0 0" mass="0.001" diaginertia="1e-7 1e-7 1e-7"/>
          <joint name="slit_width" axis="1 0 0"/>
          <geom name="sl_knob_w_R" type="cylinder" fromto=" 0.028 0 0  0.043 0 0" size="0.0105" material="sl_black"/>
          <geom name="sl_knob_w_L" type="cylinder" fromto="-0.028 0 0 -0.043 0 0" size="0.0105" material="sl_black"/>
        </body>
        <geom name="sl_knob_4_R" class="sl" type="cylinder" fromto=" 0.028 0.075 0.067  0.039 0.075 0.067" size="0.0075" material="sl_black"/>
        <geom name="sl_knob_4_L" class="sl" type="cylinder" fromto="-0.028 0.075 0.067 -0.039 0.075 0.067" size="0.0075" material="sl_black"/>

        <!-- 鏡筒：患者の方(+y)を向く。光軸の高さ z=0.75+0.04+0.26=1.05 -->
        <body name="microscope" pos="0 0 0.26" gravcomp="1">
          <geom name="scope_tube" group="3" type="cylinder" fromto="0 -0.06 0 0 0.12 0" size="0.025" material="lamp_mat"/>
          <geom name="eyepiece_L" group="3" type="cylinder" fromto="-0.016 -0.06 0.01 -0.016 -0.10 0.03" size="0.008" material="black_mat"/>
          <geom name="eyepiece_R" group="3" type="cylinder" fromto=" 0.016 -0.06 0.01  0.016 -0.10 0.03" size="0.008" material="black_mat"/>
          <!-- SL130 の顕微鏡（見た目のみ）：本体、患者側の黒い面と対物レンズ、接眼部 -->
          <geom name="sl_mic_body"  class="sl" type="box" pos="0 0.01 0" size="0.032 0.048 0.034"/>
          <geom name="sl_mic_front" class="sl" type="box" pos="0 0.062 0" size="0.032 0.004 0.034" material="sl_black"/>
          <geom name="sl_objective" class="sl" type="cylinder" fromto="0 0.066 0 0 0.072 0" size="0.021" material="sl_glass"/>
          <geom name="sl_bino_box"  class="sl" type="box" pos="0 -0.05 0.014" size="0.026 0.014 0.03"/>
          <geom name="sl_bino_L"    class="sl" type="cylinder" fromto="-0.017 -0.055 0.03 -0.02 -0.108 0.064" size="0.0115"/>
          <geom name="sl_bino_R"    class="sl" type="cylinder" fromto=" 0.017 -0.055 0.03  0.02 -0.108 0.064" size="0.0115"/>
          <geom name="sl_ocular_L"  class="sl" type="cylinder" fromto="-0.02 -0.108 0.064 -0.021 -0.13 0.078" size="0.0135" material="sl_black"/>
          <geom name="sl_ocular_R"  class="sl" type="cylinder" fromto=" 0.02 -0.108 0.064  0.021 -0.13 0.078" size="0.0135" material="sl_black"/>
          <!-- 倍率ドラムの目印：検者側の白い点（左右両側）。この前に来た数字が今の倍率 -->
          <geom name="sl_drum_index_R" class="sl" type="sphere" pos=" 0.0322 -0.0195 0" size="0.0012" material="sl_steel"/>
          <geom name="sl_drum_index_L" class="sl" type="sphere" pos="-0.0322 -0.0195 0" size="0.0012" material="sl_steel"/>
          <!-- 倍率ドラム（左右両側が1つの部品＝一緒に回る）。+60°ごとに 12→20→32→12→8→5→12 -->
          <body name="sl_mag_drum" pos="0 0.01 0" childclass="sl">
            <inertial pos="0 0 0" mass="0.001" diaginertia="1e-7 1e-7 1e-7"/>
            <joint name="mag_drum" axis="1 0 0"/>
            <geom name="sl_drum_R" type="mesh" mesh="dial_R" pos=" 0.0352 0 0" material="dial_R_mat"/>
            <geom name="sl_drum_L" type="mesh" mesh="dial_L" pos="-0.0352 0 0" material="dial_L_mat"/>
            <geom name="sl_drum_bar_R" type="box" pos=" 0.041 0 0" size="0.003 0.0135 0.004" material="sl_black"/>
            <geom name="sl_drum_bar_L" type="box" pos="-0.041 0 0" size="0.003 0.0135 0.004" material="sl_black"/>
            <geom name="sl_drum_nub_R" type="sphere" pos=" 0.0442 0 0" size="0.0022" material="sl_knurl"/>
            <geom name="sl_drum_nub_L" type="sphere" pos="-0.0442 0 0" size="0.0022" material="sl_knurl"/>
          </body>
          <!-- 細隙灯カメラ：対物レンズ位置から +y を見る（カメラは自分の -z 方向を見るため xyaxes で向きを指定） -->
          <camera name="slit_cam" pos="0 0.125 0" xyaxes="1 0 0 0 0 1" fovy="15"/>
          <!-- 細隙光：斜めから当てるスポットライト -->
          <body name="illum_arm" pos="0.06 0.02 0.05" gravcomp="1">
            <geom name="illum_tube" group="3" type="cylinder" fromto="0 0 0 0 0 0.10" size="0.012" material="lamp_mat"/>
            <!-- 光源から眼まで y方向に約0.3m、x に -0.06m、z に -0.05m ずれているので、その方向へ向ける -->
            <light name="slit_light" pos="0 0.02 0" dir="-0.2 1 -0.17" directional="false" castshadow="false"
                   cutoff="6" exponent="10" diffuse="0.4 0.4 0.35" attenuation="1 0 0"/>
          </body>
        </body>
      </body>
    </body>

    <!-- ===== 患者側 ===== -->
    <!-- 顎台：左右の支柱、顎受け、額当て -->
    <body name="chinrest" pos="0 0.27 0.75">
      <geom name="cr_pole_L" group="3" type="cylinder" fromto="-0.13 0 0 -0.13 0 0.45" size="0.008" material="metal_mat"/>
      <geom name="cr_pole_R" group="3" type="cylinder" fromto=" 0.13 0 0  0.13 0 0.45" size="0.008" material="metal_mat"/>
      <geom name="chin_cup" group="3"  type="box" pos="0 0.03 0.20" size="0.04 0.03 0.008" material="black_mat"/>
      <geom name="forehead" group="3"  type="cylinder" fromto="-0.13 0.0 0.40 0.13 0.0 0.40" size="0.01" material="black_mat"/>
      <!-- SL130 の顎台・額当て（見た目のみ）。赤い印は眼の高さ（外眼角の目安） -->
      <geom name="sl_pole_foot_L" class="sl" type="box" pos="-0.13 0 0.012" size="0.022 0.03 0.012"/>
      <geom name="sl_pole_foot_R" class="sl" type="box" pos=" 0.13 0 0.012" size="0.022 0.03 0.012"/>
      <geom name="sl_pole_L" class="sl" type="cylinder" fromto="-0.13 0 0 -0.13 0 0.45" size="0.0085" material="sl_steel"/>
      <geom name="sl_pole_R" class="sl" type="cylinder" fromto=" 0.13 0 0  0.13 0 0.45" size="0.0085" material="sl_steel"/>
      <geom name="sl_mark_L" class="sl" type="cylinder" pos="-0.13 0 0.30" size="0.0088 0.0015" material="sl_red"/>
      <geom name="sl_mark_R" class="sl" type="cylinder" pos=" 0.13 0 0.30" size="0.0088 0.0015" material="sl_red"/>
      <geom name="sl_top_cap_L" class="sl" type="box" pos="-0.13 0 0.455" size="0.018 0.02 0.01"/>
      <geom name="sl_top_cap_R" class="sl" type="box" pos=" 0.13 0 0.455" size="0.018 0.02 0.01"/>
      <geom name="sl_band_C"  class="sl" type="capsule" fromto="-0.045 -0.042 0.44  0.045 -0.042 0.44" size="0.009"/>
      <geom name="sl_band_L"  class="sl" type="capsule" fromto="-0.13 0 0.455 -0.045 -0.042 0.44" size="0.009"/>
      <geom name="sl_band_R"  class="sl" type="capsule" fromto=" 0.13 0 0.455  0.045 -0.042 0.44" size="0.009"/>
      <geom name="sl_chin_bar" class="sl" type="box" pos="0 0 0.185" size="0.14 0.012 0.008"/>
      <geom name="sl_chin_cup" class="sl" type="ellipsoid" pos="0 -0.01 0.2" size="0.038 0.03 0.012" material="sl_black"/>
      <geom name="sl_chin_knob" class="sl" type="cylinder" fromto="0.13 0 0.03 0.13 0 0.16" size="0.013" material="sl_black"/>
    </body>

    <!-- 頭部：楕円体。眼の高さ z=1.05（鏡筒の光軸と同じ高さ） -->
    <body name="head" pos="0 0.32 1.05">
      <geom name="skull" type="ellipsoid" size="0.075 0.09 0.11" pos="0 0 0.02" material="skin_mat"/>
      <!-- 患者は -y を向いているので、患者の右眼は x<0 側 -->
      <body name="eye_R" pos="-0.032 -0.085 0">
        <geom name="eyeball_R" type="sphere" size="0.012" material="sclera_mat"/>
        <!-- 円柱はz軸向きが既定なので、x軸まわりに90°回して y 方向へ向ける -->
        <!-- 球面(半径12mm)より手前に置かないと、球が虹彩を突き抜けて見える -->
        <geom name="iris_R"  type="cylinder" pos="0 -0.0122 0" euler="90 0 0" size="0.006 0.0004" material="iris_mat"/>
        <geom name="pupil_R" type="cylinder" pos="0 -0.0127 0" euler="90 0 0" size="0.0025 0.0002" material="pupil_mat"/>
        <site name="pupil_R_center" pos="0 -0.013 0" size="0.001"/>
        <!-- 瞼（M4-E）：使わないときは眼球の奥（頭の中）に隠す。sim/env.py が、表示する形だけを眼の位置へ動かす -->
        <geom name="lid_up_00" type="mesh" mesh="lid_up_00" pos="0 0.05 0" material="skin_mat" contype="0" conaffinity="0"/>
        <geom name="lid_up_01" type="mesh" mesh="lid_up_01" pos="0 0.05 0" material="skin_mat" contype="0" conaffinity="0"/>
        <geom name="lid_up_02" type="mesh" mesh="lid_up_02" pos="0 0.05 0" material="skin_mat" contype="0" conaffinity="0"/>
        <geom name="lid_up_03" type="mesh" mesh="lid_up_03" pos="0 0.05 0" material="skin_mat" contype="0" conaffinity="0"/>
        <geom name="lid_up_04" type="mesh" mesh="lid_up_04" pos="0 0.05 0" material="skin_mat" contype="0" conaffinity="0"/>
        <geom name="lid_up_05" type="mesh" mesh="lid_up_05" pos="0 0.05 0" material="skin_mat" contype="0" conaffinity="0"/>
        <geom name="lid_up_06" type="mesh" mesh="lid_up_06" pos="0 0.05 0" material="skin_mat" contype="0" conaffinity="0"/>
        <geom name="lid_up_07" type="mesh" mesh="lid_up_07" pos="0 0.05 0" material="skin_mat" contype="0" conaffinity="0"/>
        <geom name="lid_up_08" type="mesh" mesh="lid_up_08" pos="0 0.05 0" material="skin_mat" contype="0" conaffinity="0"/>
        <geom name="lid_up_09" type="mesh" mesh="lid_up_09" pos="0 0.05 0" material="skin_mat" contype="0" conaffinity="0"/>
        <geom name="lid_up_10" type="mesh" mesh="lid_up_10" pos="0 0.05 0" material="skin_mat" contype="0" conaffinity="0"/>
        <geom name="lid_up_11" type="mesh" mesh="lid_up_11" pos="0 0.05 0" material="skin_mat" contype="0" conaffinity="0"/>
        <geom name="lid_up_12" type="mesh" mesh="lid_up_12" pos="0 0.05 0" material="skin_mat" contype="0" conaffinity="0"/>
        <geom name="lid_low" type="mesh" mesh="lid_low" pos="0 0.05 0" material="skin_mat" contype="0" conaffinity="0"/>
      </body>
      <body name="eye_L" pos="0.032 -0.085 0">
        <geom name="eyeball_L" type="sphere" size="0.012" material="sclera_mat"/>
        <geom name="iris_L"  type="cylinder" pos="0 -0.0122 0" euler="90 0 0" size="0.006 0.0004" material="iris_mat"/>
        <geom name="pupil_L" type="cylinder" pos="0 -0.0127 0" euler="90 0 0" size="0.0025 0.0002" material="pupil_mat"/>
        <site name="pupil_L_center" pos="0 -0.013 0" size="0.001"/>
      </body>
    </body>

    <!-- ===== ロボットアーム（医師の席側）=====
         6関節：土台旋回・肩・肘・手首（曲げ・横曲げ・回転）。gravcomp で自重を打ち消す。
         全関節を伸ばすと真上を向く姿勢が 0°。 -->
    <body name="arm_base" pos="0 -0.45 0" childclass="arm">
      <geom name="pedestal" type="cylinder" fromto="0 0 0 0 0 0.75" size="0.05" material="arm_dark"/>
      <body name="arm_link0" pos="0 0 0.75" gravcomp="1">
        <joint name="a_yaw" axis="0 0 1" range="-90 90"/>
        <geom name="arm_g0" type="cylinder" fromto="0 0 0 0 0 0.10" size="0.04"/>
        <body name="arm_upper" pos="0 0 0.10" gravcomp="1">
          <joint name="a_shoulder" axis="1 0 0" range="-120 120"/>
          <geom name="arm_g1" type="capsule" fromto="0 0 0 0 0 0.20" size="0.025"/>
          <body name="arm_fore" pos="0 0 0.20" gravcomp="1">
            <joint name="a_elbow" axis="1 0 0" range="-160 160"/>
            <geom name="arm_g2" type="capsule" fromto="0 0 0 0 0 0.20" size="0.02"/>
            <!-- 手首：曲げ(x軸)・横曲げ(y軸)・回転(z軸)の3軸が1点で交わる（人の手首と同じ） -->
            <body name="arm_wrist" pos="0 0 0.20" gravcomp="1">
              <joint name="a_wrist_pitch" axis="1 0 0" range="-150 150"/>
              <joint name="a_wrist_dev"   axis="0 1 0" range="-60 60"/>
              <geom name="arm_g3" type="sphere" size="0.022" material="arm_dark"/>
              <body name="hand" gravcomp="1">
                <joint name="a_wrist_roll" axis="0 0 1" range="-360 360"/>
                <geom name="palm"     type="cylinder" fromto="0 0 0.01 0 0 0.05" size="0.018"/>
                <geom name="finger_a" type="box" pos=" 0.022 0 0.075" size="0.004 0.012 0.025" material="arm_dark"/>
                <geom name="finger_b" type="box" pos="-0.022 0 0.075" size="0.004 0.012 0.025" material="arm_dark"/>
                <!-- 握る点：2本の指の間。ここをノブの中心に重ねる -->
                <site name="grip" pos="0 0 0.08" size="0.004"/>
              </body>
            </body>
          </body>
        </body>
      </body>
    </body>

    <!-- 俯瞰カメラ：斜め上から全体を見る（動画の左画面用） -->
    <body name="view_target" pos="0 0.05 0.95"/>
    <camera name="overview" mode="targetbody" target="view_target" pos="0.75 -0.55 1.35"/>
  </worldbody>

  <!-- ===== 連動拘束（M1）：ジョイスティックの角度 → 本体の位置 =====
       joint1 = c0 + c1*joint2 （polycoef の 1番目と2番目だけ使う一次式）
       符号：js_roll を + に回すとノブは +x（右）へ倒れる → 本体も右へ
             js_pitch を + に回すとノブは -y（手前）へ倒れる → 奥(+y)へ押すのは − なので符号を反転
             js_spin を + に回す（上から見て反時計回り）→ 鏡筒が上がる。半回転(π rad)で10mm -->
  <equality>
    <joint name="link_x" joint1="lamp_x" joint2="js_roll"  polycoef="0  0.15    0 0 0"/>
    <joint name="link_y" joint1="lamp_y" joint2="js_pitch" polycoef="0 -0.15    0 0 0"/>
    <joint name="link_z" joint1="lamp_z" joint2="js_spin"  polycoef="0  0.00318 0 0 0"/>
    <!-- 把持：手とジョイスティックを溶接（最初は OFF。握る姿勢を作ってからプログラムで ON にする） -->
    <weld name="grasp" body1="hand" body2="joystick" active="false" solref="0.01 1"/>
  </equality>

  <!-- アームの各関節に「この角度へ行け」と指示する位置制御モーター -->
  <actuator>
    <position name="m_yaw"         joint="a_yaw"         class="arm"/>
    <position name="m_shoulder"    joint="a_shoulder"    class="arm"/>
    <position name="m_elbow"       joint="a_elbow"       class="arm"/>
    <position name="m_wrist_pitch" joint="a_wrist_pitch" class="arm"/>
    <position name="m_wrist_dev"   joint="a_wrist_dev"   class="arm"/>
    <position name="m_wrist_roll"  joint="a_wrist_roll"  class="arm"/>
  </actuator>
</mujoco>
